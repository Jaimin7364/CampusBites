{
  "name": "@campusbites/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "cleanup:auth": "tsx src/scripts/cleanup-auth-records.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "express-rate-limit": "8.6.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.2.0",
    "pino": "9.9.4",
    "pino-http": "10.5.0",
    "socket.io": "^4.8.3",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "10.0.0",
    "eslint": "9.36.0",
    "prisma": "6.12.0",
    "socket.io-client": "^4.8.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.7"
  }
}
