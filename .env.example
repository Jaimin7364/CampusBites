# API
NODE_ENV=development
API_PORT=4000
DATABASE_URL="mysql://campusbites:Campus%402026%21@localhost:3306/campusbites"
LOG_LEVEL=info
BUSINESS_TIME_ZONE=Asia/Kolkata
CART_MAX_ITEM_QUANTITY=20
DELIVERY_CHARGE_PAISE=0
PLATFORM_FEE_PAISE=0
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# Required only while running `npm run seed:admin -w @campusbites/api`
ADMIN_EMAIL=admin@campusbites.local
ADMIN_PHONE=+919876543210
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=CampusBites Admin

# Web (copy this value to apps/web/.env.local when needed)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
